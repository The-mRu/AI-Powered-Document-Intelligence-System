# Copy to backend/.env and fill in. NEVER commit the real file.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
ENVIRONMENT=development
PROCESSING_MODE=celery
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
# Optional hardening: when set, every /api request must send header  X-API-Key: <value>
API_KEY=
# Optional: database password used by docker-compose (default: app)
DB_PASSWORD=app
# Optional limits
MAX_UPLOAD_MB=500
MAX_FILES_PER_REQUEST=20
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
